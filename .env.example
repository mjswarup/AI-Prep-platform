# Example environment variables for Prep platform
# Copy this file to .env and fill values for local development

# MongoDB connection string (optional). If set, backend will use MongoDB persistence.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=prep_platform
MONGODB_USERS_COLLECTION=users

# Admin credentials created/updated on startup when MongoDB is enabled
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_NAME=Admin
ADMIN_COLLEGE=Admin Institute
ADMIN_GRAD_YEAR=2026

# OpenAI API key (optional). If set, AI features will proxy to OpenAI.
OPENAI_API_KEY=

# Server port
PORT=3000
